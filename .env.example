# SPECTRE Environment Configuration
# Copy this file to .env and fill in your values

# Hyprland Window Manager Integration
# Set to the class name for your application window (default: "spectre")
WINDOW_MANAGER_CLASS=spectre

# Python runtime command (python3 or python) - defaults to python3 from PATH
# Optional: set PYTHON_CMD=python if your system uses 'python' instead of 'python3'
PYTHON_CMD=python3

# Kokoro TTS model path (optional, auto-detects if not set)
KOKORO_MODEL_PATH=

# LM Studio API key for TTS requests (required for get-tts-audio IPC handler)
# Get your API key from: https://lmstudio.ai/dashboard/api-keys
LM_STUDIO_API_KEY=

# LM Studio OpenAI-compatible endpoint
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1

# Optional: select a model when multiple LLMs are loaded
LM_STUDIO_MODEL=

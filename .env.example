# SPECTRE Environment Variables
# Copy this file to .env and modify with your actual values

# Fetch timeout for TTS API requests (milliseconds)
# Default: 30000ms
OPENAI_TIMEOUT=30000

# LM Studio API Key for local TTS synthesis
# Get a free key at https://lmstudio.ai/ or use your own license
# If running local LM Studio with CORS enabled, this may not be needed
LM_STUDIO_API_KEY="your-api-key-here"

# Electron renderer path - set by build process, typically auto-detected
# Uncomment if you need to override the default path
# ELECTRON_RENDERER_PATH="./src/preload/index.ts"

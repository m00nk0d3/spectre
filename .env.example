# SPECTRE Environment Configuration
# Copy this file to .env and fill in your values

# Hyprland Window Manager Integration
# Set to the class name for your application window (default: "spectre")
WINDOW_MANAGER_CLASS=spectre

# Python runtime command (python3 or python) - defaults to python3 from PATH
# Optional: set PYTHON_CMD=python if your system uses 'python' instead of 'python3'
PYTHON_CMD=python3

# Kokoro TTS model path (optional, auto-detects if not set)
KOKORO_MODEL_PATH=

# LM Studio API key for TTS requests (required for get-tts-audio IPC handler)
# Get your API key from: https://lmstudio.ai/dashboard/api-keys
LM_STUDIO_API_KEY=

# LM Studio OpenAI-compatible endpoint
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1

# Optional: select a model when multiple LLMs are loaded
LM_STUDIO_MODEL=

# Optional official Discord bot transport. It remains disabled unless every
# required value is present. Never use a user account token or self-bot.
SPECTRE_DISCORD_ENABLED=false
SPECTRE_DISCORD_TOKEN=
SPECTRE_DISCORD_OWNER_USER_ID=
# Comma-separated guild text channel IDs. Guild messages outside this list are
# ignored, and configured channels still require an explicit bot mention.
SPECTRE_DISCORD_ALLOWED_CHANNEL_IDS=
# Optional Discord voice support. Voice remains fail-closed when this allowlist
# is empty. Map every voice ID to a guild text channel as voiceId:textId.
SPECTRE_DISCORD_ALLOWED_VOICE_CHANNEL_IDS=
SPECTRE_DISCORD_VOICE_TEXT_CHANNEL_MAP=
# Recommended: comma-separated guild IDs for immediate guild-scoped slash
# command synchronization. If empty, Discord global command propagation applies.
SPECTRE_DISCORD_COMMAND_GUILD_IDS=
# Optional comma-separated subset: review_requested,ci_failed,issue_assigned,
# github_mention,workflow_completed
SPECTRE_DISCORD_NOTIFICATION_TYPES=
# Optional safety and polling intervals in milliseconds.
SPECTRE_DISCORD_CONFIRMATION_TTL_MS=120000
SPECTRE_DISCORD_DIGEST_INTERVAL_MS=21600000
SPECTRE_DISCORD_NOTIFICATION_POLL_INTERVAL_MS=60000
# Per-user/channel defense-in-depth limits.
SPECTRE_DISCORD_REQUEST_TIMEOUT_MS=90000
SPECTRE_DISCORD_RATE_LIMIT_PER_MINUTE=8
SPECTRE_DISCORD_MAX_INPUT_CHARACTERS=1800
# After a speaker says "Spectre" once, allow natural follow-up speech for five
# minutes. Each accepted utterance refreshes this inactivity timeout.
SPECTRE_DISCORD_VOICE_SESSION_TIMEOUT_MS=300000
